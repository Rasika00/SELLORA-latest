datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id               String      @id
  name             String
  badge            String?
  badgeColor       String?     @default("cyan")
  category         String
  processor        String
  price            Float
  priceUsd         String?
  cpu              String
  ram              String
  gpu              String
  display          String?
  batteryWeight    String?
  specialHighlight String?
  img              String
  detailedSpecs    Json?
  stock            Int         @default(15)
  status           String      @default("APPROVED")
  seller           User?       @relation("SellerProducts", fields: [sellerId], references: [id])
  sellerId         String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]
  reviews          Review[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String
  firstName    String?
  lastName     String?
  phone        String?
  address      String?
  role         String    @default("customer")
  storeName    String?
  storeBio     String?
  sellerStatus String    @default("NONE")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  products     Product[] @relation("SellerProducts")
  reviews      Review[]
  addresses    Address[]
}

model Order {
  id                String               @id @default(cuid())
  orderNumber       String               @unique
  user              User?                @relation(fields: [userId], references: [id])
  userId            String?
  customerName      String
  customerEmail     String
  customerPhone     String?
  shippingAddress   String
  city              String?
  zipCode           String?
  totalAmount       Float
  status            String               @default("PENDING")
  carrierName       String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  trackingEvents    OrderTrackingEvent[]
  items             OrderItem[]
  reviews           Review[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model OrderTrackingEvent {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    String
  note      String?
  actorId   String?  // null for automatically generated events
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int      @default(1)
  price     Float
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  comment   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, orderId])
}

model Feedback {
  id               String   @id @default(cuid())
  name             String
  role             String   @default("Verified Operator")
  rigModel         String   @default("Sellora Machine")
  category         String   @default("Gaming")
  rating           Int      @default(5)
  message          String
  verifiedPurchase Boolean  @default(true)
  likes            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Address {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  label         String   @default("Home")
  recipientName String
  phone         String
  streetAddress String
  city          String
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

